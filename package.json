{
  "name": "sniff-pet-kuafor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "next build && playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "seed:media": "node scripts/seed-media.mts",
    "db:types": "supabase gen types --lang typescript --schema public | prettier --stdin-filepath database.types.ts > src/shared/supabase/database.types.ts",
    "db:env": "supabase status -o env --override-name api.url=SUPABASE_URL --override-name auth.publishable_key=SUPABASE_PUBLISHABLE_KEY --override-name auth.secret_key=SUPABASE_SECRET_KEY | grep ^SUPABASE_ | tr -d \\\"",
    "test:db": "supabase test db",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:db && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
