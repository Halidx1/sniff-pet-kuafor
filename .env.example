# Copy to .env.local for local development. Never commit real values.

# Public base URL of the site (used for absolute URLs in metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only on the production deploy (netlify.toml does this). Anything else sends noindex.
SITE_INDEXABLE=false

# Supabase. Locally: run `npm run db:start`, then `npm run -s db:env >> .env.local`.
# On Netlify: the dev project for previews/branch deploys, the prod project for production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side scripts and integration tests only; never in the browser, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
